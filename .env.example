DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
AUTH_SECRET="chay: npx auth secret de sinh gia tri"

# Google OAuth (đăng nhập với Google). Tạo tại console.cloud.google.com → APIs & Services → Credentials.
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google (dev) + domain production.
GOOGLE_CLIENT_ID="....apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-..."

GEMINI_API_KEY="AIza... (lay mien phi tai aistudio.google.com/apikey)"

RESEND_API_KEY="re_... (lay tai resend.com; bo trong -> khong gui email, chi in-app)"
EMAIL_FROM="SmartHire <onboarding@resend.dev>"
APP_URL="http://localhost:3000"

# Rate-limit dùng chung (khuyến nghị cho production). Bỏ trống -> fallback in-memory (chỉ đúng trong 1 instance, hợp dev/test).
UPSTASH_REDIS_REST_URL="https://... (tạo free tại upstash.com)"
UPSTASH_REDIS_REST_TOKEN="..."

# Vercel Blob (logo storage). Get from vercel.com → Storage → Blob → Connect.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Web Push (VAPID). Generate keys: npx web-push generate-vapid-keys
# Bỏ trống -> không gửi push notification.
VAPID_PUBLIC_KEY="..."
VAPID_PRIVATE_KEY="..."
VAPID_SUBJECT="mailto:minhnguyen120898@gmail.com"
NEXT_PUBLIC_VAPID_PUBLIC_KEY="..."

# Sentry error monitoring (tùy chọn — bỏ trống -> không gửi events).
# Tạo project tại sentry.io, lấy DSN từ Settings → Client Keys.
SENTRY_DSN="https://...@....ingest.sentry.io/..."
NEXT_PUBLIC_SENTRY_DSN="https://...@....ingest.sentry.io/..."
SENTRY_ORG="your-org-slug"
SENTRY_PROJECT="your-project-slug"
SENTRY_AUTH_TOKEN="sntrys_..."
